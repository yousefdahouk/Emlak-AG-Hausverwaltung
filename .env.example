# Where inquiry form submissions are delivered
INQUIRY_TO_EMAIL=flowmeterinquiries@gmail.com
INQUIRY_FROM_EMAIL="Emlak AG Hausverwaltung <flowmeterinquiries@gmail.com>"

# SMTP transport. Leave SMTP_HOST empty in local development:
# submissions are then written to .dev-inquiries/ and logged to the console
# instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
